terraform {
  required_version = ">= 1.6"
  required_providers {
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.40"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# Reads DIGITALOCEAN_TOKEN (or DIGITALOCEAN_ACCESS_TOKEN) from the environment.
provider "digitalocean" {}
